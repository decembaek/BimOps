<Window x:Class="BimOps.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BimOps - 세대 옵션 물량 자동화"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- 컬러 팔레트 -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1E5A8E"/>
        <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="White"/>
        <SolidColorBrush x:Key="HeaderSubtleBrush" Color="#CCFFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ToolbarBrush" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#616161"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#E8F0F7"/>

        <!-- 컨텍스트 ComboBox -->
        <Style x:Key="ContextComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- 기본 버튼 -->
        <Style x:Key="DefaultButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 헤더용 외곽선 버튼 -->
        <Style x:Key="HeaderOutlineButtonStyle" TargetType="Button"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <!-- 브레드크럼의 '홈' 링크 -->
        <Style x:Key="BreadcrumbLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Txt"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 헤더 -->
            <RowDefinition Height="Auto"/>
            <!-- 컨텍스트 바 (작업 화면일 때만) -->
            <RowDefinition Height="*"/>
            <!-- 본문 -->
            <RowDefinition Height="Auto"/>
            <!-- 상태바 -->
        </Grid.RowDefinitions>

        <!-- 1. 헤더 -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- 로고 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 구분선 -->
                    <ColumnDefinition Width="*"/>
                    <!-- 단지명 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 단지 변경 -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="BimOps"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryForegroundBrush}"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="1"
                        Width="1" Height="18"
                        Background="{StaticResource HeaderSubtleBrush}"
                        Margin="14,0"/>

                <TextBlock Grid.Column="2"
                           x:Name="TxtHeaderProject"
                           Text="—"
                           FontSize="13"
                           Foreground="{StaticResource HeaderSubtleBrush}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="3"
                        Content="단지 변경"
                        Style="{StaticResource HeaderOutlineButtonStyle}"
                        MinWidth="90"
                        Click="BtnChangeProject_Click"/>
            </Grid>
        </Border>

        <!-- 2. 컨텍스트 바 (브레드크럼 + 차수 드롭다운) -->
        <Border x:Name="ContextBar"
                Grid.Row="1"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,10"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 브레드크럼 -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="홈"
                            Style="{StaticResource BreadcrumbLinkStyle}"
                            Click="BtnHome_Click"/>
                    <TextBlock Text="  ›  "
                               Foreground="{StaticResource TextTertiaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBreadcrumb"
                               Text=""
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 차수 드롭다운 (화면별 visibility 제어) -->
                <StackPanel Grid.Column="1"
                            x:Name="RoundContextPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="차수"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="CboRound"
                              Style="{StaticResource ContextComboBoxStyle}"
                              DisplayMemberPath="ComboLabel"
                              SelectionChanged="CboRound_SelectionChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. 본문 (단일 ContentControl) -->
        <ContentControl Grid.Row="2"
                        x:Name="MainContent"
                        Margin="20"/>

        <!-- 4. 상태바 -->
        <Border Grid.Row="3"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <TextBlock x:Name="StatusText"
                           Text="Status: Ready"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="LastSavedText"
                           Text="Last Saved: --:--"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>