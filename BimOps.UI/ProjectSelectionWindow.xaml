<Window x:Class="BimOps.UI.ProjectSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BimOps - 프로젝트 선택"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- 컬러 팔레트 (MainWindow와 동일) -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1E5A8E"/>
        <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="White"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ToolbarBrush" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#616161"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#E8F0F7"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="#D4E4F0"/>
        <SolidColorBrush x:Key="BadgeInProgressBgBrush" Color="#E6F1FB"/>
        <SolidColorBrush x:Key="BadgeInProgressFgBrush" Color="#0C447C"/>
        <SolidColorBrush x:Key="BadgeCompletedBgBrush" Color="#F1EFE8"/>
        <SolidColorBrush x:Key="BadgeCompletedFgBrush" Color="#444441"/>

        <!-- 기본 버튼 -->
        <Style x:Key="DefaultButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 강조 버튼 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 필터 토글 버튼 -->
        <Style x:Key="FilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 단지 카드 -->
        <Style x:Key="ProjectCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Width" Value="320"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 카드 내 라벨 텍스트 -->
        <Style x:Key="CardLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="CardMutedStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 헤더 -->
            <RowDefinition Height="Auto"/>
            <!-- 툴바 (검색·필터·새 프로젝트) -->
            <RowDefinition Height="*"/>
            <!-- 카드 그리드 -->
            <RowDefinition Height="Auto"/>
            <!-- 상태바 -->
        </Grid.RowDefinitions>

        <!-- 1. 헤더 -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                Padding="20,14">
            <TextBlock Text="BimOps - 프로젝트 선택"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryForegroundBrush}"/>
        </Border>

        <!-- 2. 툴바 -->
        <Border Grid.Row="1"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- 검색 -->
                    <ColumnDefinition Width="*"/>
                    <!-- 필터 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 새 프로젝트 -->
                </Grid.ColumnDefinitions>

                <!-- 검색 박스 -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Width="280" Height="28">
                    <Grid>
                        <TextBox x:Name="TxtSearch"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"
                                 TextChanged="TxtSearch_TextChanged"/>
                        <TextBlock x:Name="TxtSearchPlaceholder"
                                   Text="단지명·코드 검색..."
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- 필터 토글 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="필터"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ToggleButton x:Name="BtnFilterAll"
                                  Content="전체"
                                  IsChecked="True"
                                  Style="{StaticResource FilterToggleStyle}"
                                  Click="FilterToggle_Click"
                                  Tag="All"/>
                    <ToggleButton x:Name="BtnFilterInProgress"
                                  Content="진행중"
                                  Style="{StaticResource FilterToggleStyle}"
                                  Click="FilterToggle_Click"
                                  Tag="InProgress"/>
                    <ToggleButton x:Name="BtnFilterCompleted"
                                  Content="완료"
                                  Style="{StaticResource FilterToggleStyle}"
                                  Click="FilterToggle_Click"
                                  Tag="Completed"/>
                </StackPanel>

                <!-- 새 프로젝트 -->
                <Button Grid.Column="2"
                        Content="+ 새 프로젝트"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="120"
                        Click="BtnNewProject_Click"/>
            </Grid>
        </Border>

        <!-- 3. 카드 그리드 -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,20,8,20">
            <Grid>
                <ItemsControl x:Name="ProjectList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProjectCardStyle}"
                                    Tag="{Binding}"
                                    MouseLeftButtonUp="ProjectCard_Click">
                                <StackPanel>
                                    <!-- 카드 상단: 코드·이름 + 상태 배지 -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Code}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- 상태 배지 (간단히 진행중 스타일) -->
                                        <Border Grid.Column="1"
                                                Background="{Binding StatusBgBrush}"
                                                CornerRadius="3"
                                                Padding="6,2"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="10"
                                                       Foreground="{Binding StatusFgBrush}"/>
                                        </Border>
                                    </Grid>

                                    <!-- 메타 정보 -->
                                    <TextBlock Text="{Binding MetaSummary}"
                                               Style="{StaticResource CardLabelStyle}"
                                               Margin="0,0,0,6"/>

                                    <!-- 하단: 최신 차수 + 마지막 수정 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding LatestRoundLabel}"
                                                   Style="{StaticResource CardLabelStyle}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding LastModifiedLabel}"
                                                   Style="{StaticResource CardMutedStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 빈 상태 메시지 -->
                <TextBlock x:Name="EmptyMessage"
                           Text="검색 조건에 맞는 단지가 없습니다."
                           Foreground="{StaticResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,40,0,0"
                           Visibility="Collapsed"/>
            </Grid>
        </ScrollViewer>

        <!-- 4. 상태바 -->
        <Border Grid.Row="3"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <TextBlock x:Name="StatusText"
                           Text="Status: Ready"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="CountText"
                           Text=""
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>