<UserControl x:Class="BimOps.UI.Views.DataManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BimOps.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#FAFAFA"
             TextElement.Foreground="#212121"
             TextElement.FontFamily="Segoe UI"
             TextElement.FontSize="13">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1E5A8E"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ToolbarBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#616161"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D32F2F"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#388E3C"/>
        <SolidColorBrush x:Key="SuccessBgBrush" Color="#E8F5E9"/>
        <SolidColorBrush x:Key="ErrorBgBrush"   Color="#FFEBEE"/>

        <!-- 기본 버튼 -->
        <Style x:Key="DefaultButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F0F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
        </Style>

        <!-- 툴바 버튼 (작게) -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- 탭 헤더 -->
        <Style x:Key="DataTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 페이지 제목 -->
            <RowDefinition Height="Auto"/>
            <!-- 탭 헤더 -->
            <RowDefinition Height="Auto"/>
            <!-- 툴바 -->
            <RowDefinition Height="*"/>
            <!-- 데이터 그리드 -->
            <RowDefinition Height="Auto"/>
            <!-- 검증 결과 -->
        </Grid.RowDefinitions>

        <!-- 1. 페이지 제목 -->
        <TextBlock Grid.Row="0"
                   Text="데이터 관리"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="4,4,4,16"/>

        <!-- 2. 탭 헤더 -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Margin="4,0">
            <TabControl x:Name="DataTabs"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        SelectionChanged="DataTabs_SelectionChanged">
                <TabControl.ItemContainerStyle>
                    <StaticResource ResourceKey="DataTabItemStyle"/>
                </TabControl.ItemContainerStyle>

                <!-- 탭 컨텐츠 영역은 비워두고, 아래 공통 영역에서 처리 -->
                <TabItem Header="옵션마스터"/>
                <TabItem Header="분양별 판매옵션"/>
                <TabItem Header="옵션그룹"/>
                <TabItem Header="물량룰"/>
                <TabItem Header="공간매핑"/>
                <TabItem Header="물량항목매핑"/>
            </TabControl>
        </Border>

        <!-- 3. 툴바 -->
        <Border Grid.Row="2"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                Margin="4,0">
            <WrapPanel Orientation="Horizontal">
                <Button Content="Excel 가져오기"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="BtnExcelImport_Click"/>
                <Button Content="Excel 내보내기"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="BtnExcelExport_Click"/>

                <Border Width="1" Margin="6,4"
                        Background="{StaticResource DividerBrush}"/>

                <Button Content="행 추가"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="BtnAddRow_Click"/>
                <Button Content="행 삭제"
                        Style="{StaticResource DangerButtonStyle}"
                        Height="30"
                        Padding="12,0"
                        Margin="0,0,6,0"
                        Click="BtnDeleteRow_Click"/>

                <Border Width="1" Margin="6,4"
                        Background="{StaticResource DividerBrush}"/>

                <Button Content="검증"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="BtnValidate_Click"/>
                <Button Content="저장"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="30"
                        Padding="14,0"
                        Click="BtnSave_Click"/>
            </WrapPanel>
        </Border>

        <!-- 4. 데이터 그리드 -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1,0,1,1"
                Margin="4,0">
            <DataGrid x:Name="GridData"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeight="32"
                      Background="White"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      BorderThickness="0"
                      HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFAFA">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource ToolbarBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="12,4"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No"          Binding="{Binding No}"         Width="50"/>
                    <DataGridTextColumn Header="OptionCode"  Binding="{Binding OptionCode}" Width="160"/>
                    <DataGridTextColumn Header="OptionName"  Binding="{Binding OptionName}" Width="*"/>
                    <DataGridTextColumn Header="Category"    Binding="{Binding Category}"   Width="120"/>
                    <DataGridTextColumn Header="RoomCode"    Binding="{Binding RoomCode}"   Width="120"/>
                    <DataGridTextColumn Header="사용"        Binding="{Binding IsUsed}"     Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 5. 검증 결과 -->
        <Border Grid.Row="4"
                x:Name="ValidationPanel"
                Background="{StaticResource SuccessBgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1"
                Padding="16,12"
                Margin="4,8,4,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtValidationIcon"
                           Text="✓"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{StaticResource SuccessBrush}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtValidationMessage"
                           Text="오류 없음"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>