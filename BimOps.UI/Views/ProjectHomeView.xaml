<UserControl x:Class="BimOps.UI.Views.ProjectHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             FontSize="13"
             Background="Transparent">

    <UserControl.Resources>
        <!-- 컬러 팔레트 -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1E5A8E"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#616161"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#E8F0F7"/>

        <!-- 카드 컨테이너 (단지 정보 / 타임라인 / 작업 카드 공통) -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- 작업 진입 카드 -->
        <Style x:Key="WorkCardStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 차수 카드 -->
        <Style x:Key="RoundCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 새 차수 버튼 -->
        <Style x:Key="AddRoundButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ===== 1. 단지 메타 정보 ===== -->
            <Border Style="{StaticResource PanelStyle}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtProjectTitle"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtProjectMeta"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="단지 정보 편집"
                            Style="{StaticResource EditButtonStyle}"
                            VerticalAlignment="Top"
                            Click="BtnEditProject_Click"/>
                </Grid>
            </Border>

            <!-- ===== 2. 차수 타임라인 ===== -->
            <Border Style="{StaticResource PanelStyle}"
                    Padding="20"
                    Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="차수 타임라인"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12"/>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl x:Name="RoundTimeline">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- 차수 카드 -->
                                            <Border Style="{StaticResource RoundCardStyle}"
                                                    BorderBrush="{Binding BorderBrush}"
                                                    BorderThickness="{Binding BorderThickness}"
                                                    Tag="{Binding}"
                                                    MouseLeftButtonUp="RoundCard_Click">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="🔒"
                                                                   FontSize="10"
                                                                   Visibility="{Binding LockIconVisibility}"
                                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                                    </Grid>
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding DateLabel}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1"
                                                                Background="{Binding StatusBgBrush}"
                                                                CornerRadius="3"
                                                                Padding="5,1">
                                                            <TextBlock Text="{Binding Status}"
                                                                       FontSize="10"
                                                                       Foreground="{Binding StatusFgBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- 화살표 (마지막 항목 제외) -->
                                            <TextBlock Text="→"
                                                       Margin="6,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Visibility="{Binding ArrowVisibility}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 새 차수 버튼 -->
                            <Button x:Name="BtnAddRound"
                                    Content="+ 새 차수"
                                    Style="{StaticResource AddRoundButtonStyle}"
                                    Margin="6,0,0,0"
                                    Click="BtnAddRound_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ===== 3. 작업 진입 카드 그리드 ===== -->
            <UniformGrid Columns="3" Margin="0,12,-12,0">

                <Border Style="{StaticResource WorkCardStyle}"
            Tag="ReferenceData"
            MouseLeftButtonUp="WorkCard_Click">
                    <StackPanel>
                        <TextBlock Text="기준 데이터"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtReferenceMeta"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WorkCardStyle}"
            Tag="UnitOptionStatus"
            MouseLeftButtonUp="WorkCard_Click">
                    <StackPanel>
                        <TextBlock Text="세대 옵션 현황"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtUnitOptionMeta"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WorkCardStyle}"
            Tag="QuantityCalculation"
            MouseLeftButtonUp="WorkCard_Click">
                    <StackPanel>
                        <TextBlock Text="옵션 물량 산출"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtCalcMeta"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WorkCardStyle}"
            Tag="QuantityResult"
            MouseLeftButtonUp="WorkCard_Click">
                    <StackPanel>
                        <TextBlock Text="산출 결과"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtResultMeta"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WorkCardStyle}"
            Tag="HistoryReport"
            MouseLeftButtonUp="WorkCard_Click">
                    <StackPanel>
                        <TextBlock Text="산출 이력 / 보고서"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtHistoryMeta"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 6번째 슬롯은 빈 자리 또는 향후 확장 (예: "프로젝트 설정") -->
                <Border/>

            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>