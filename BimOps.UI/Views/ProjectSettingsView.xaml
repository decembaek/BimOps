<UserControl x:Class="BimOps.UI.Views.ProjectSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             FontSize="13"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BimOps.UI;component/Themes/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 사이드바 항목 -->
            <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4" Margin="6,2">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="프로젝트 설정" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtSubtitle"
                           FontSize="13"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 본문: 사이드바 + 컨텐츠 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <ListBox x:Name="NavMenu"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         SelectedIndex="0"
                         SelectionChanged="NavMenu_SelectionChanged">
                    <ListBoxItem Content="마감재 카테고리" Tag="FinishCategory"/>
                    <ListBoxItem Content="단지 정보" Tag="ProjectInfo"/>
                    <ListBoxItem Content="사용자 권한" Tag="Permissions"/>
                </ListBox>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="12,0,0,0">
                <ContentControl x:Name="ContentArea" Margin="20"/>
            </Border>
        </Grid>

        <!-- 푸터 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button Content="← 홈으로 돌아가기"
                    HorizontalAlignment="Left"
                    Style="{StaticResource DefaultButtonStyle}"
                    Click="BtnBack_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="저장"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="90"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>