<UserControl x:Class="BimOps.UI.Views.QuantityCalculationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             FontSize="13"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BimOps.UI;component/Themes/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 섹션 카드 -->
            <Style x:Key="SectionStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <!-- 검증 항목 카드 -->
            <Style x:Key="ValidationItemStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- 산출 단계 행 -->
            <Style x:Key="StageRowStyle" TargetType="Border">
                <Setter Property="Padding" Value="0,8"/>
            </Style>

            <!-- 마감재 결과 카드 -->
            <Style x:Key="FinishCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SubtleBgBrush}"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- ===== 헤더 ===== -->
            <Grid Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="옵션 물량 산출" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtSubtitle"
                               FontSize="13"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnRevalidate"
                            Content="검증 재실행"
                            Style="{StaticResource SmallButtonStyle}"
                            Click="BtnRevalidate_Click"/>
                    <Button x:Name="BtnRunCalc"
                            Content="산출 실행"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="110"
                            Margin="6,0,0,0"
                            Click="BtnRunCalc_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== 산출 대상 요약 ===== -->
            <Border Style="{StaticResource SectionStyle}">
                <StackPanel>
                    <TextBlock Text="산출 대상 요약" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="단지" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtTargetProject" Text="JJ-A1" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="차수" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtTargetRound" Text="2차 (DRAFT)" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="대상 세대" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtTargetUnits" Text="1,248" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="옵션 종류" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtTargetOptions" Text="27" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="차감 룩업" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtTargetLookups" Text="312행" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 검증 결과 ===== -->
            <Border Style="{StaticResource SectionStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="검증 결과" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        <TextBlock x:Name="TxtValidationSummary"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                    <ItemsControl x:Name="ValidationList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ValidationItemStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Detail}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{Binding StatusBgBrush}"
                                                CornerRadius="3"
                                                Padding="8,3"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding StatusFgBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 산출 진행 ===== -->
            <Border Style="{StaticResource SectionStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="산출 진행" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        <TextBlock x:Name="TxtElapsed"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <ProgressBar x:Name="CalcProgress"
                                 Height="6"
                                 Minimum="0" Maximum="100" Value="0"
                                 Margin="0,0,0,12"/>

                    <ItemsControl x:Name="StageList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StageRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StatusIcon}"
                                                   Foreground="{Binding StatusBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 산출 결과 요약 (실행 후) ===== -->
            <Border x:Name="ResultSection"
                    Style="{StaticResource SectionStyle}"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="산출 결과 요약" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        <Button Content="산출 결과 화면으로 →"
                                HorizontalAlignment="Right"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BtnGoResult_Click"/>
                    </Grid>

                    <ItemsControl x:Name="ResultList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FinishCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FinishName}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding DisplayQty}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Uom}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="4,0,0,3"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>