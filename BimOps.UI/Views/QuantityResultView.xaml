<UserControl x:Class="BimOps.UI.Views.QuantityResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             FontSize="13"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BimOps.UI;component/Themes/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 통계 카드 -->
            <Style x:Key="StatCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SubtleBgBrush}"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <!-- 합계 행 강조 -->
            <Style x:Key="TotalRowStyle" TargetType="DataGridRow">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTotal}" Value="True">
                        <Setter Property="Background" Value="{StaticResource SubtleBgBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 헤더 -->
            <RowDefinition Height="Auto"/>
            <!-- 통계 -->
            <RowDefinition Height="*"/>
            <!-- 탭 -->
        </Grid.RowDefinitions>

        <!-- ===== 헤더 ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="산출 결과" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtSubtitle"
                           FontSize="13"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
                <Border Background="{StaticResource BadgeSuccessBgBrush}"
                        CornerRadius="3"
                        Padding="6,2"
                        Margin="10,0,0,0">
                    <TextBlock Text="산출 완료"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BadgeSuccessFgBrush}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="재산출"
                        Style="{StaticResource SmallButtonStyle}"
                        Click="BtnRecalc_Click"/>
                <Button Content="이력 / 보고서로 →"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="6,0,0,0"
                        Click="BtnGoHistory_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== 통계 카드 ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="총 세대" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtTotalUnits"
                               Text="—" FontSize="18" FontWeight="SemiBold"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="옵션 적용 세대" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtAppliedUnits"
                               Text="—" FontSize="18" FontWeight="SemiBold"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="옵션 선택 건" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtSelectionCount"
                               Text="—" FontSize="18" FontWeight="SemiBold"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource StatCardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="산출 시각" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtCalcTime"
                               Text="—" FontSize="14" FontWeight="SemiBold"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 탭 ===== -->
        <TabControl Grid.Row="2"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource DividerBrush}"
                    Background="Transparent">

            <!-- 탭 1: 동별 집계 -->
            <TabItem Header="동별 집계">
                <Grid Margin="0,12,0,0">
                    <DataGrid x:Name="BuildingGrid"
                              RowStyle="{StaticResource TotalRowStyle}"/>
                </Grid>
            </TabItem>

            <!-- 탭 2: 세대별 명세 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="세대별 명세"/>
                        <TextBlock x:Name="TxtUnitCount"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="필터:"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ComboBox x:Name="CboBuildingFilter"
                                  Width="140" Height="26"
                                  SelectionChanged="CboBuildingFilter_SelectionChanged"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="UnitGrid"/>
                </Grid>
            </TabItem>

            <!-- 탭 3: 옵션별 적용 통계 -->
            <TabItem Header="옵션별 적용 통계">
                <Grid Margin="0,12,0,0">
                    <DataGrid x:Name="OptionStatGrid"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>