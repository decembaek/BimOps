<UserControl x:Class="BimOps.UI.Views.ReferenceDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             FontSize="13"
             Background="Transparent">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1E5A8E"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="SubtleBgBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#E8F0F7"/>

        <!-- 작은 액션 버튼 -->
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid 공통 스타일 -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SubtleBgBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SubtleBgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 좌측 리스트 아이템 -->
        <Style x:Key="LeftListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6F1FB"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 탭 헤더 -->
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="기준 데이터" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtSubtitle" FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="Excel 일괄 임포트"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SmallButton}"
                    Click="BtnExcelImport_Click"/>
        </Grid>

        <!-- 4개 탭 -->
        <TabControl Grid.Row="1"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource DividerBrush}"
                    Background="Transparent">

            <!-- 탭 1: 평형타입 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="평형타입"/>
                        <TextBlock x:Name="TxtUnitTypeCount"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="+ 평형 추가" Style="{StaticResource SmallButton}" Click="BtnAddUnitType_Click"/>
                        <Button Content="선택 행 삭제" Style="{StaticResource SmallButton}" Click="BtnDeleteUnitType_Click"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="UnitTypeGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="코드" Binding="{Binding Code}" Width="100"/>
                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="전용면적 (㎡)" Binding="{Binding NetArea}" Width="140"/>
                            <DataGridTextColumn Header="비고" Binding="{Binding Remark}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 탭 2: Revit 기본물량 -->
            <TabItem Header="Revit 기본물량">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="평형타입 선택"
                                       Margin="10,8,10,4"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <ListBox x:Name="UnitListForBQ"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemContainerStyle="{StaticResource LeftListItem}"
                                     SelectionChanged="UnitListForBQ_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Code}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding NetAreaLabel}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource SubtleBgBrush}"
                                CornerRadius="4"
                                Padding="12,10"
                                Margin="0,0,0,8">
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="TxtBQTitle"
                                               Text="평형을 선택하세요"
                                               FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtBQSubtitle"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="Revit에서 추출"
                                            Style="{StaticResource SmallButton}"
                                            Click="BtnExtractFromRevit_Click"/>
                                    <Button Content="+ 행 추가"
                                            Style="{StaticResource SmallButton}"
                                            Click="BtnAddBQRow_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" x:Name="BQGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="마감재" Binding="{Binding FinishName}" Width="120"/>
                                <DataGridTextColumn Header="적용 위치" Binding="{Binding AppliedRoom}" Width="*"/>
                                <DataGridTextColumn Header="기본 물량" Binding="{Binding Quantity}" Width="90"/>
                                <DataGridTextColumn Header="단위" Binding="{Binding Uom}" Width="60"/>
                                <DataGridTextColumn Header="출처" Binding="{Binding Source}" Width="80" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 탭 3: 옵션 카탈로그 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="옵션 카탈로그"/>
                        <TextBlock x:Name="TxtOptionCount"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="+ 옵션 추가" Style="{StaticResource SmallButton}" Click="BtnAddOption_Click"/>
                        <Button Content="선택 행 삭제" Style="{StaticResource SmallButton}" Click="BtnDeleteOption_Click"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="OptionGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="코드" Binding="{Binding Code}" Width="100"/>
                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="카테고리" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="설치 가능 위치" Binding="{Binding InstallRooms}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 탭 4: 차감 룩업 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="차감 룩업"/>
                        <TextBlock x:Name="TxtLookupCount"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="옵션 선택"
                                       Margin="10,8,10,4"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <ListBox x:Name="OptionListForLookup"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemContainerStyle="{StaticResource LeftListItem}"
                                     SelectionChanged="OptionListForLookup_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding Code}" FontWeight="SemiBold"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Name}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource SubtleBgBrush}"
                                CornerRadius="4"
                                Padding="12,10"
                                Margin="0,0,0,8">
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="TxtLookupTitle"
                                               Text="옵션을 선택하세요"
                                               FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtLookupSubtitle"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Content="+ 룩업 행 추가"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource SmallButton}"
                                        Click="BtnAddLookupRow_Click"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" x:Name="LookupGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="설치위치" Binding="{Binding InstallRoom}" Width="120"/>
                                <DataGridTextColumn Header="평형" Binding="{Binding UnitTypeCode}" Width="80"/>
                                <DataGridTextColumn Header="마감재" Binding="{Binding FinishName}" Width="120"/>
                                <DataGridTextColumn Header="delta" Binding="{Binding DeltaQty}" Width="90"/>
                                <DataGridTextColumn Header="단위" Binding="{Binding Uom}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>