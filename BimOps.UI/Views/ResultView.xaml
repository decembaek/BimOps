<UserControl x:Class="BimOps.UI.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BimOps.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             Background="#FAFAFA"
             TextElement.Foreground="#212121"
             TextElement.FontFamily="Segoe UI"
             TextElement.FontSize="13">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1E5A8E"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ToolbarBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#616161"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D32F2F"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#388E3C"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9E9E9E"/>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>

        <Style x:Key="DefaultButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F0F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- 탭 헤더 -->
        <Style x:Key="ResultTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid 공통 -->
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ToolbarBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 최상위: 스크롤 영역 + 하단 고정 버튼 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Background="Transparent">
            <Grid Margin="4,4,4,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 페이지 제목 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 결과 요약 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 탭 + 데이터 그리드 -->
                </Grid.RowDefinitions>

                <!-- 1. 페이지 제목 -->
                <TextBlock Grid.Row="0"
                           Text="결과 / 보고서"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,24"/>

                <!-- 2. 결과 요약 (KPI 4개) -->
                <StackPanel Grid.Row="1" Margin="0,0,0,24">
                    <TextBlock Text="결과 요약" Style="{StaticResource SectionTitleStyle}"/>
                    <UniformGrid Rows="1" Columns="4">
                        <UniformGrid.Resources>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="Margin" Value="0,0,12,0"/>
                                <Setter Property="Padding" Value="20,16"/>
                            </Style>
                        </UniformGrid.Resources>

                        <Border>
                            <StackPanel>
                                <TextBlock Text="물량 버전"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtVersion"
                                           Text="V3"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel>
                                <TextBlock Text="변경 세대 수"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtChangedUnits"
                                           Text="72"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border>
                            <StackPanel>
                                <TextBlock Text="추가 옵션 수"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtAddedOptions"
                                           Text="48"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0">
                            <StackPanel>
                                <TextBlock Text="오류 건수"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtErrorCount"
                                           Text="0"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- 3. 탭 + 데이터 그리드 -->
                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 탭 헤더 -->
                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,0,0,1">
                            <TabControl x:Name="ResultTabs"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        SelectionChanged="ResultTabs_SelectionChanged">
                                <TabControl.ItemContainerStyle>
                                    <StaticResource ResourceKey="ResultTabItemStyle"/>
                                </TabControl.ItemContainerStyle>
                                <TabItem Header="최종 누적 물량"/>
                                <TabItem Header="이전 대비 변경분"/>
                                <TabItem Header="세대별 상세"/>
                                <TabItem Header="옵션별 집계"/>
                                <TabItem Header="오류 리포트"/>
                            </TabControl>
                        </Border>

                        <!-- 데이터 그리드 -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="16,12,16,8">
                                <TextBlock x:Name="TxtCurrentTabName"
                                           Text="이전 대비 변경분"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtRowCount"
                                           Text="총 0건"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"/>
                            </Grid>

                            <DataGrid Grid.Row="1"
                                      x:Name="GridResult"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      RowHeight="32"
                                      MinHeight="200"
                                      MaxHeight="420"
                                      Background="White"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderThickness="0,1,0,0"
                                      BorderBrush="{StaticResource DividerBrush}"
                                      HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                                      RowBackground="White"
                                      AlternatingRowBackground="#FAFAFA"
                                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource DataGridCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="옵션명"     Binding="{Binding OptionName}" Width="*"/>
                                    <DataGridTextColumn Header="항목"       Binding="{Binding ItemName}"   Width="*"/>
                                    <DataGridTextColumn Header="이전 물량"  Binding="{Binding PreviousQty}" Width="120"/>
                                    <DataGridTextColumn Header="현재 물량"  Binding="{Binding CurrentQty}"  Width="120"/>
                                    <DataGridTextColumn Header="증감"       Binding="{Binding Delta}"      Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 하단 고정 액션 바 -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <!-- 왼쪽: 출력 버튼 -->
                <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Button Content="Excel 출력"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="BtnExportExcel_Click"/>
                    <Button Content="CSV 출력"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="BtnExportCsv_Click"/>
                    <Button Content="JSON 저장"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="BtnSaveJson_Click"/>
                </WrapPanel>

                <!-- 오른쪽: 완료 표시 (강조) -->
                <Button Content="현장 전달 완료 표시"
                        Style="{StaticResource SuccessButtonStyle}"
                        Height="36"
                        Padding="20,0"
                        HorizontalAlignment="Right"
                        Click="BtnMarkAsDelivered_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>